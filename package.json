{
  "name": "videos",
  "version": "1.0.0",
  "description": "A video uploader and gallery backed by Google Cloud Storage.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nat Welch <nat@natwelch.com>",
  "repository": "https://github.com/icco/videos.git",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm type-check && pnpm format:check",
    "test:smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^3.6.1",
    "@heroicons/react": "^2.2.0",
    "@icco/react-common": "^2026.11128.1",
    "@opentelemetry/api": "~1.10.0",
    "@vercel/otel": "^2.3.0",
    "busboy": "^1.6.0",
    "jsdom": "^31.0.1",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsid-ts": "^0.0.9"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.8.3",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
