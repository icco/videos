{
  "name": "nextjs-template",
  "version": "1.0.0",
  "description": "A Next.js starter for icco projects.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Nat Welch <nat@natwelch.com>",
  "repository": "https://github.com/icco/nextjs-template.git",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm type-check && pnpm format:check",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@icco/react-common": "^2026.10919.1",
    "jsdom": "^30.1.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.43",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
